# ============================================================================
# QuAgent Environment Configuration
# Copy to .env and fill in your values
# ============================================================================

# IB Gateway / TWS Connection Settings
# Paper trading: port 7497 (default)
# Live trading: port 7496
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Your IBKR Account ID
# Format: DU123456 or similar
ACCOUNT_ID=

# Database Configuration
# Relative to project root
DATABASE_URL=sqlite:///data/trading_log.sqlite

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# Trading Mode
# Options: paper, live
# WARNING: Set to "live" only with extreme caution
TRADING_MODE=paper

# Paper Trading Settings
PAPER_MAX_POSITION_SIZE=10000
PAPER_BUYING_POWER_LIMIT=50000
PAPER_MAX_DAILY_LOSS_PCT=2.0

# Live Trading Settings (EXTREMELY CONSERVATIVE)
# These are NOT used unless explicitly enabled
LIVE_MAX_POSITION_SIZE=5000
LIVE_BUYING_POWER_LIMIT=25000
LIVE_MAX_DAILY_LOSS_PCT=1.0

# Enable Live Trading (set to true only after thorough testing)
# Even with this set, you must confirm at startup
ALLOW_LIVE=false

